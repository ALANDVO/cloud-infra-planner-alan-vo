# cloud-infra-planner-alan-vo — environment configuration
# Copy to .env and fill in. No real credentials are committed.
# In production, ALL secrets MUST be provided via the environment.

# --- Server ---
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development     # development | production

# --- Database (SQLite by default; override for Postgres if desired) ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Auth: provide real secrets in production (min 32 chars) ---
JWT_SECRET=replace-with-a-long-random-secret-in-production
CSRF_SECRET=replace-with-a-long-random-csrf-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Keycloak / OIDC (planned SSO integration) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=cloud-infra-planner
KEYCLOAK_CLIENT_ID=cloud-infra-planner
KEYCLOAK_CLIENT_SECRET=

# --- Demo mode (LOCAL HOST ONLY; refused in production) ---
DEMO_MODE=true

# --- LLM (optional, opt-in; keys stay server-side only) ---
LLM_PROVIDER=openai            # openai | openrouter | litellm | ollama | vllm | anthropic | gemini | offline
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=